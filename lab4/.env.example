# Пример переменных окружения для локального запуска без Docker.
# В docker-compose.yml значения уже заданы.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/flights
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/flights
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/flights
SUPPLIER_URLS=http://127.0.0.1:8101,http://127.0.0.1:8102,http://127.0.0.1:8103
SUPPLIER_TIMEOUT=2.0
SUPPLIER_RETRY_DELAY=0.2
SEED_START_DATE=2026-11-01
SEED_DAYS=120
OWN_FLIGHTS_PER_DAY=1500
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
LOG_LEVEL=INFO
SEARCH_CONCURRENCY=35
PROCESS_POOL_WORKERS=2
