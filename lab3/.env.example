# Переменные окружения приложения ЛР3 (скопировать в .env)
PORT=8000
LOG_LEVEL=INFO

# Поведение внешних участников (позволяет пройти альтернативные пути процесса):
# PAYMENT_APPROVE_AUTH=false -> путь P4 «поездка не начата: авторизация отклонена» (F4)
# PAYMENT_CAPTURE_OK=false   -> путь P8 «поездка завершена с задолженностью» (F5)
# PARKING_ALLOWED=false      -> цикл G6 «самокат вне разрешённой зоны»
PAYMENT_APPROVE_AUTH=true
PAYMENT_CAPTURE_OK=true
PARKING_ALLOWED=true
PARKING_ZONE=Зона А
